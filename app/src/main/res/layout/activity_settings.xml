<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← 返回"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="后台保活设置"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/tvBatteryStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="状态：检测中…"
            android:textSize="13sp"
            android:layout_marginTop="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="为保证「摇晃录音」在后台持续监听、不被系统关闭，请完成以下设置（国产 ROM 如荣耀/华为必需）："
            android:textSize="13sp"
            android:layout_marginTop="10dp" />

        <Button
            android:id="@+id/btnBattery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="① 忽略电池优化（后台保活）" />

        <Button
            android:id="@+id/btnAppDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="② 应用信息 → 电池选「无限制」、允许多任务加锁" />

        <Button
            android:id="@+id/btnNotifSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="③ 通知管理 → 允许通知（前台服务需要）" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="提示：在多任务界面把这个应用「下拉加锁」，可进一步防止被清理。"
            android:textSize="12sp"
            android:layout_marginTop="12dp" />

    </LinearLayout>
</ScrollView>
